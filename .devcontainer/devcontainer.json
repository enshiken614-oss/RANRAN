{
  "name": "HER UNIVERSE · 私密预览",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-24-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "HER UNIVERSE 手机预览",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start-preview.sh"
}
