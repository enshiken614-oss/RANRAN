# Copy to .env.local. Never commit real values.
# Development with no access code permits a local sample preview.
# Production stays closed until BOTH variables are configured.
# At least 8 characters; choose a long, unique code.
UNIVERSE_ACCESS_CODE=

# At least 32 characters; generate a fresh random secret locally:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never use NEXT_PUBLIC_ prefixes for credentials.
UNIVERSE_SESSION_SECRET=

# Optional: canonical origin used for request-origin validation, with no path.
# UNIVERSE_SITE_URL=https://your-domain.example
